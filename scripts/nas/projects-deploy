#!/usr/bin/env bash
set -Eeuo pipefail

if [[ $# -ne 0 ]]; then
  echo "Usage: projects-deploy"
  exit 64
fi

TARGET="/tmp/zfsv3/sata11/13816937329/data/docker/projects"
ARTIFACT_DIR="/tmp/projects-deploy"
CODE_ARCHIVE="$ARTIFACT_DIR/projects-code.tar.gz"
IMAGE_ARCHIVE="$ARTIFACT_DIR/docker-images.tar"
LOG_DIR="$TARGET/backups/deploy-logs"

if [[ "$(id -u)" -ne 0 ]]; then
  echo "projects-deploy must run as root."
  exit 77
fi

for required_path in \
  "$TARGET/docker-compose.yml" \
  "$TARGET/docker-compose.zspace.yml" \
  "$TARGET/subi_knowledge_platform/.env" \
  "$TARGET/subi_knowledge_platform/.env.integration" \
  "$TARGET/instrument-training-home/.env" \
  "$TARGET/subi_knowledge_platform/data/subi_knowledge.db" \
  "$TARGET/instrument-training-home/data/instrument_training.db" \
  "$TARGET/subi_knowledge_platform/uploads" \
  "$CODE_ARCHIVE" \
  "$IMAGE_ARCHIVE"
do
  if [[ ! -e "$required_path" ]]; then
    echo "Required deployment path is missing: $required_path"
    exit 66
  fi
done

install -d -o root -g root -m 700 "$LOG_DIR"
STAMP="$(date +%Y-%m-%d_%H%M%S)"
LOG_FILE="$LOG_DIR/deploy_$STAMP.log"
exec > >(tee "$LOG_FILE") 2>&1

echo "=== NAS deployment started: $(date -Is) ==="
BACKUP_DIR="$TARGET/backups/pre_update_$STAMP"
mkdir -p "$BACKUP_DIR"

echo "Creating data and runtime configuration backup: $BACKUP_DIR"
cp -a "$TARGET/subi_knowledge_platform/data/subi_knowledge.db" "$BACKUP_DIR/subi_knowledge.db"
cp -a "$TARGET/instrument-training-home/data/instrument_training.db" "$BACKUP_DIR/instrument_training.db"
cp -a "$TARGET/subi_knowledge_platform/.env" "$BACKUP_DIR/subi_knowledge_platform.env"
cp -a "$TARGET/subi_knowledge_platform/.env.integration" "$BACKUP_DIR/subi_knowledge_platform.env.integration"
cp -a "$TARGET/instrument-training-home/.env" "$BACKUP_DIR/instrument_training.env"
tar -C "$TARGET/subi_knowledge_platform" -czf "$BACKUP_DIR/subi_uploads.tar.gz" uploads

echo "Applying code package (runtime configuration, databases, uploads excluded)"
tar -xzf "$CODE_ARCHIVE" -C "$TARGET" --no-same-owner --no-same-permissions

echo "Loading pre-built Docker images"
docker load -i "$IMAGE_ARCHIVE"

echo "Starting Compose services without rebuilding"
cd "$TARGET"
docker compose -f docker-compose.yml -f docker-compose.zspace.yml up -d --no-build

echo "Waiting for backend health checks"
for attempt in $(seq 1 24); do
  if docker exec instrument_train_backend python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/ready', timeout=10)" >/dev/null 2>&1 \
    && docker exec subi_backend python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8001/health', timeout=10)" >/dev/null 2>&1; then
    echo "Backend health checks passed on attempt $attempt."
    break
  fi

  if [[ "$attempt" -eq 24 ]]; then
    echo "Backend health checks did not become ready within 120 seconds."
    docker compose -f docker-compose.yml -f docker-compose.zspace.yml ps
    docker compose -f docker-compose.yml -f docker-compose.zspace.yml logs --tail 100 subi-backend instrument-training-home-backend
    exit 1
  fi

  sleep 5
done

docker compose -f docker-compose.yml -f docker-compose.zspace.yml ps
chmod 600 "$LOG_FILE"
echo "BACKUP_DIR=$BACKUP_DIR"
echo "DEPLOYMENT_SUCCESS"
