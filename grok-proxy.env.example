REM 复制为 grok-proxy.env 后按需修改（grok-proxy.env 已被 .gitignore 忽略，不会上传）

REM HTTP/HTTPS 代理（Clash 默认 7890，v2rayN 常见 10808）
set "PROXY_HOST=127.0.0.1"
set "PROXY_PORT=7890"
set "PROXY_SCHEME=http"

REM 可选：SOCKS5 代理（Clash 默认 7891）。若只用 HTTP，可注释掉下一行
set "SOCKS_PROXY=socks5://127.0.0.1:7891"

REM 不走代理的地址
set "NO_PROXY=localhost,127.0.0.1,::1,*.local"

REM 可选：Grok 工作目录（默认 C:\projects）
REM set "GROK_WORKDIR=C:\projects"