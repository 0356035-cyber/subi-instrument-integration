# 复制为 subi_knowledge_platform/.env 并填写实际值
# docker-compose 会通过 env_file 加载，并用内部服务名覆盖 API 地址

INSTRUMENT_TRAINING_API_BASE=http://localhost:8000/api/v1
INSTRUMENT_TRAINING_SERVICE_EMPLOYEE_ID=your_service_account_id
INSTRUMENT_TRAINING_SERVICE_PASSWORD=your_service_account_password
INSTRUMENT_TRAINING_TIMEOUT=10

# 主机侧 Sub-I API 端口；容器内部始终为 8001。
# 极空间若 8001 已被占用，可在根目录 .env 中设置为 18001。
SUBI_API_HOST_PORT=8001
